{
  "uid": "mempool-database",
  "title": "Database",
  "description": "Postgres access through api/src/db/instrument.rs. Pool wait and query time are measured separately, because a slow repository call means either the database is slow or every connection is busy -- and those need different fixes.",
  "tags": [
    "mempool-observer",
    "database"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "Dashboards",
      "tags": [
        "mempool-observer"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "table",
      "title": "Query latency, by repository and operation -- budget 250ms",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "min": 0,
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.0625
              },
              {
                "color": "orange",
                "value": 0.125
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "p75",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "avg",
              "Value #E": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(histogram_quantile(0.75, sum by (repo, op, le) (rate(db_query_seconds_bucket[$__range])))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(histogram_quantile(0.95, sum by (repo, op, le) (rate(db_query_seconds_bucket[$__range])))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "(histogram_quantile(0.99, sum by (repo, op, le) (rate(db_query_seconds_bucket[$__range])))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "(sum by (repo, op) (rate(db_query_seconds_sum[$__range])) / sum by (repo, op) (rate(db_query_seconds_count[$__range]))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "ceil(sum by (repo, op) (increase(db_query_seconds_count[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Pool checkout -- budget 50ms",
      "description": "Its own table because its budget is a fifth of a query's: waiting tens of milliseconds for a connection is contention, while the same number in a query is unremarkable. Sharing a threshold would have hidden it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "min": 0,
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.0125
              },
              {
                "color": "orange",
                "value": 0.025
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "p75",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "avg",
              "Value #E": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.75, sum by (le) (rate(db_pool_acquire_seconds_bucket[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.95, sum by (le) (rate(db_pool_acquire_seconds_bucket[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.99, sum by (le) (rate(db_pool_acquire_seconds_bucket[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "(sum by (operation) (label_replace(sum (rate(db_pool_acquire_seconds_sum[$__range])) / sum (rate(db_pool_acquire_seconds_count[$__range])), \"operation\", \"db pool acquire\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum by (operation) (label_replace(ceil(sum (increase(db_pool_acquire_seconds_count[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Pool",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query p95 by repository and operation",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (repo, op, le) (rate(db_query_seconds_bucket[5m])))",
          "legendFormat": "{{repo}}/{{op}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pool acquire p95",
      "description": "Rising here means the pool is the bottleneck, not the query.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_pool_acquire_seconds_bucket[5m])))",
          "legendFormat": "acquire"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pool occupancy",
      "description": "waiting > 0 means callers are queued behind the pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "db_pool_connections",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors",
      "description": "Acquire errors are pool exhaustion or an unreachable database -- the clearest backpressure signal there is.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "60 * (sum by (repo, op) (rate(db_query_errors_total[5m])))",
          "legendFormat": "query {{repo}}/{{op}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "60 * (sum by (repo, op) (rate(db_pool_acquire_errors_total[5m])))",
          "legendFormat": "acquire {{repo}}/{{op}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      }
    }
  ]
}
