                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "p75",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "avg",
              "Value #E": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.75, sum by (le) (rate(cluster_snapshot_build_seconds_bucket[$__range]))), \"operation\", \"snapshot build\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.95, sum by (le) (rate(cluster_snapshot_build_seconds_bucket[$__range]))), \"operation\", \"snapshot build\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.99, sum by (le) (rate(cluster_snapshot_build_seconds_bucket[$__range]))), \"operation\", \"snapshot build\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "(sum by (operation) (label_replace(sum (rate(cluster_snapshot_build_seconds_sum[$__range])) / sum (rate(cluster_snapshot_build_seconds_count[$__range])), \"operation\", \"snapshot build\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum by (operation) (label_replace(ceil(sum (increase(cluster_snapshot_build_seconds_count[$__range]))), \"operation\", \"snapshot build\", \"\", \"\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 8
      }
