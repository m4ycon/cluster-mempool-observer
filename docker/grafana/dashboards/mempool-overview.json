    {
      "id": 3,
      "type": "table",
      "title": "Fast paths -- budget 50ms",
      "description": "Work that touches neither the database nor the node, plus the pool checkout itself. All of it should be sub-millisecond, so this is the table with the least slack -- a pool checkout drifting into tens of milliseconds is contention, long before anything else notices.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "min": 0,
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.0125
              },
              {
                "color": "orange",
                "value": 0.025
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "p75",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "avg",
              "Value #E": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.75, sum by (le) (rate(db_pool_acquire_seconds_bucket[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.75, sum by (le) (rate(cluster_snapshot_build_seconds_bucket[$__range]))), \"operation\", \"cluster snapshot build\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.75, sum by (subject, le) (rate(zmq_message_handle_seconds_bucket[$__range]))), \"operation\", \"zmq handle / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.95, sum by (le) (rate(db_pool_acquire_seconds_bucket[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.95, sum by (le) (rate(cluster_snapshot_build_seconds_bucket[$__range]))), \"operation\", \"cluster snapshot build\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.95, sum by (subject, le) (rate(zmq_message_handle_seconds_bucket[$__range]))), \"operation\", \"zmq handle / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.99, sum by (le) (rate(db_pool_acquire_seconds_bucket[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.99, sum by (le) (rate(cluster_snapshot_build_seconds_bucket[$__range]))), \"operation\", \"cluster snapshot build\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.99, sum by (subject, le) (rate(zmq_message_handle_seconds_bucket[$__range]))), \"operation\", \"zmq handle / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "(sum by (operation) (label_replace(sum (rate(db_pool_acquire_seconds_sum[$__range])) / sum (rate(db_pool_acquire_seconds_count[$__range])), \"operation\", \"db pool acquire\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(sum (rate(cluster_snapshot_build_seconds_sum[$__range])) / sum (rate(cluster_snapshot_build_seconds_count[$__range])), \"operation\", \"cluster snapshot build\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(sum by (subject) (rate(zmq_message_handle_seconds_sum[$__range])) / sum by (subject) (rate(zmq_message_handle_seconds_count[$__range])), \"operation\", \"zmq handle / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum by (operation) (label_replace(ceil(sum (increase(db_pool_acquire_seconds_count[$__range]))), \"operation\", \"db pool acquire\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(ceil(sum (increase(cluster_snapshot_build_seconds_count[$__range]))), \"operation\", \"cluster snapshot build\", \"\", \"\"))\n  or\nsum by (operation) (label_replace(ceil(sum by (subject) (increase(zmq_message_handle_seconds_count[$__range]))), \"operation\", \"zmq handle / $1\", \"subject\", \"(.*)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      }
