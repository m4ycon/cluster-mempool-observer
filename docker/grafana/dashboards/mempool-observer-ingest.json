    {
      "id": 9,
      "type": "timeseries",
      "title": "Poll failures",
      "description": "Overruns mean the poll consumed its whole interval, so the watcher is behind its configured rate. Errors are swallowed by the loop -- without this, a dead node looks like an idle mempool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
