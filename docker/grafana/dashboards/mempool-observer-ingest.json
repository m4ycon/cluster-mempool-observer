{
  "uid": "mempool-observer-ingest",
  "title": "Ingest",
  "description": "Everything that talks to Bitcoin Core: RPC calls, the polling watcher, and the ZMQ block stream.",
  "tags": [
    "mempool-observer",
    "ingest"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "Dashboards",
      "tags": [
        "mempool-observer"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "table",
      "title": "Node calls -- budget 2s",
      "description": "RPC rows include failed calls: the time was spent either way.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "min": 0,
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "orange",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 2.0
              }
            ]
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "p75",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "avg",
              "Value #E": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.75, sum by (method, le) (rate(rpc_call_seconds_bucket[$__range]))), \"operation\", \"rpc / $1\", \"method\", \"(.*)\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.75, sum by (subject, le) (rate(watcher_poll_seconds_bucket[$__range]))), \"operation\", \"watcher poll / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.95, sum by (method, le) (rate(rpc_call_seconds_bucket[$__range]))), \"operation\", \"rpc / $1\", \"method\", \"(.*)\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.95, sum by (subject, le) (rate(watcher_poll_seconds_bucket[$__range]))), \"operation\", \"watcher poll / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.99, sum by (method, le) (rate(rpc_call_seconds_bucket[$__range]))), \"operation\", \"rpc / $1\", \"method\", \"(.*)\"))\n  or\nsum by (operation) (label_replace(histogram_quantile(0.99, sum by (subject, le) (rate(watcher_poll_seconds_bucket[$__range]))), \"operation\", \"watcher poll / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "(sum by (operation) (label_replace(sum by (method) (rate(rpc_call_seconds_sum[$__range])) / sum by (method) (rate(rpc_call_seconds_count[$__range])), \"operation\", \"rpc / $1\", \"method\", \"(.*)\"))\n  or\nsum by (operation) (label_replace(sum by (subject) (rate(watcher_poll_seconds_sum[$__range])) / sum by (subject) (rate(watcher_poll_seconds_count[$__range])), \"operation\", \"watcher poll / $1\", \"subject\", \"(.*)\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum by (operation) (label_replace(ceil(sum by (method) (increase(rpc_call_seconds_count[$__range]))), \"operation\", \"rpc / $1\", \"method\", \"(.*)\"))\n  or\nsum by (operation) (label_replace(ceil(sum by (subject) (increase(watcher_poll_seconds_count[$__range]))), \"operation\", \"watcher poll / $1\", \"subject\", \"(.*)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "ZMQ handling -- budget 50ms",
      "description": "Decoding a block hash and publishing it. No network round trip, so it belongs to the fast tier rather than with the RPC calls it used to share a threshold with.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
