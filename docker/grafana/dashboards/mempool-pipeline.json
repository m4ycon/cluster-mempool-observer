{
  "uid": "mempool-pipeline",
  "title": "Mempool pipeline",
  "description": "One reconciler tick: flushing the mempool ledger's journal into mempool_deltas and hollow transactions rows, queueing new txids for backfill, then resyncing their clusters.",
  "tags": [
    "mempool-observer",
    "mempool"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "Dashboards",
      "tags": [
        "mempool-observer"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "table",
      "title": "Ledger flush -- budget 250ms",
      "description": "The reconciler's write transaction only: mempool_deltas rows plus hollow transactions rows, in one commit. Lighter by an order of magnitude than the delta-apply number this replaces, which also covered sync_clusters_for's round trip to the node -- that cost now shows up in the clusters dashboard's own sync-stage table instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "min": 0,
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.0625
              },
              {
                "color": "orange",
                "value": 0.125
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "p75",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "avg",
              "Value #E": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.75, sum by (le) (rate(mempool_ledger_flush_seconds_bucket[$__range]))), \"operation\", \"flush\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.95, sum by (le) (rate(mempool_ledger_flush_seconds_bucket[$__range]))), \"operation\", \"flush\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "(sum by (operation) (label_replace(histogram_quantile(0.99, sum by (le) (rate(mempool_ledger_flush_seconds_bucket[$__range]))), \"operation\", \"flush\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "(sum by (operation) (label_replace(sum (rate(mempool_ledger_flush_seconds_sum[$__range])) / sum (rate(mempool_ledger_flush_seconds_count[$__range])), \"operation\", \"flush\", \"\", \"\"))) >= 0",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum by (operation) (label_replace(ceil(sum (increase(mempool_ledger_flush_seconds_count[$__range]))), \"operation\", \"flush\", \"\", \"\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
