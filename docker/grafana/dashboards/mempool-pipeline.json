      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "60 * (sum by (direction) (rate(mempool_delta_txs_total[1m])))",
          "legendFormat": "{{direction}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "60 * (rate(mempool_new_txs_total[1m]))",
          "legendFormat": "newly fetched"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
