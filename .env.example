# HTTP server bind address (host:port)
BIND=127.0.0.1:3333

# Database connection settings
DB_HOST=localhost
DB_PORT=5433
DB_USER=user
DB_PASSWORD=pass
DB_NAME=mempool
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Watcher poll cadence, seconds
POLL_INTERVAL_SECS=10

# Logging configuration
LOG_LEVEL=debug # trace | debug | info | warn | error
LOG_TO_FILE=true # Set false for stdout-only
LOG_DIR=logs
LOG_MAX_FILES=7

# Metrics configuration
METRICS_ENABLED=true
METRICS_BIND=127.0.0.1:3334 # Prometheus scrape endpoint
# Use 0.0.0.0:3334 when an api on the host must be scraped from a container

# Bitcoin Core RPC
RPC_HOST=127.0.0.1:8332
RPC_USER=user
RPC_PASS=pass

# Bitcoin Core ZMQ hashblock endpoint (required; requires
# zmqpubhashblock=tcp://0.0.0.0:28332 in bitcoin.conf)
ZMQ_BLOCKS_ENDPOINT=tcp://127.0.0.1:28333

# Frontend
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:3333
VITE_WS_BASE_URL=ws://localhost:3333


# ---------------------------------------------------------------------------
# Docker ONLY

# Host IP the published ports bind to. 0.0.0.0 exposes the whole stack to
# your network, and none of it is authenticated. Container-internal ports
# are fixed constants; the rest below is what gets published.
HOST_BIND_IP=127.0.0.1
API_PORT=3333
METRICS_PORT=3334 # used by Prometheus scrape target
PROMETHEUS_PORT=9090
GRAFANA_PORT=3031

# Pruned mainnet node container. Enabling it means also pointing the RPC/ZMQ
# settings above at it: RPC_HOST=node:8332, ZMQ_BLOCKS_ENDPOINT=tcp://node:28333
NODE_ENABLED=false
NODE_RPC_PORT=8332
NODE_ZMQ_PORT=28333
NODE_PRUNE_MB=10000

# Which optional containers start. Interpolation only sees vars defined further
# up the file, so keep this below METRICS_ENABLED and NODE_ENABLED.
COMPOSE_PROFILES=metrics-${METRICS_ENABLED},node-${NODE_ENABLED}
