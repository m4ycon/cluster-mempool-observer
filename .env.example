# HTTP server bind address (host:port)
BIND=127.0.0.1:3333

# Postgres - also read by the diesel CLI for migrations
DATABASE_URL=postgres://user:pass@localhost:5432/mempool

# Watcher poll cadence, seconds
POLL_INTERVAL_SECS=10

# Logging configuration
LOG_LEVEL=debug # trace | debug | info | warn | error
LOG_TO_FILE=true # Set false for stdout-only
LOG_DIR=logs
LOG_MAX_FILES=7

# Bitcoin Core RPC
RPC_HOST=127.0.0.1:8332
RPC_USER=user
RPC_PASS=pass

# Bitcoin Core ZMQ hashblock endpoint (optional; requires
# zmqpubhashblock=tcp://0.0.0.0:28332 in bitcoin.conf)
ZMQ_BLOCKS_ENDPOINT=tcp://127.0.0.1:28332

# Watcher toggles (default true)
WATCHERS_MEMPOOL_DELTA=true
WATCHERS_BLOCK=true
